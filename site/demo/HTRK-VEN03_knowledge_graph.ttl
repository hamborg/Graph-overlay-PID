# =============================================================================
# Anlæg HTRK-VEN03 - ventilation principle diagram, ETAGE EK1
# Knowledge graph built with BOT 0.3.2, FSO 0.1.0 and Brick 1.4.4
#   Source drawing : 01_diagram.png   Legend: 02_legend.png (MOLIO C213, del 5, okt. 2019)
#   Generated      : 2026-10-08
#   Conventions    : flow direction = air flow direction.
#                    FSO flow (fso:suppliesFluidTo / fso:returnsFluidTo) runs element by element
#                    through every duct segment and junction; brick:feeds is the same topology
#                    collapsed to equipment level (ducts/junctions skipped).
#                    sig:drawingX / sig:drawingY = symbol position in 01_diagram.png (px).
# =============================================================================

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix bot: <https://w3id.org/bot#> .
@prefix fso: <https://w3id.org/fso#> .
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix sig: <https://example.org/htrk-ven03/signatures#> .
@prefix inst: <https://example.org/htrk-ven03/id/> .


###############################################################################
# Graph header
###############################################################################

<https://example.org/htrk-ven03/>
    a owl:Ontology ;
    rdfs:label "Anlæg HTRK-VEN03 - ventilation principle diagram, ETAGE EK1 (knowledge graph)"@en ;
    rdfs:comment "Knowledge graph of the ventilation principle diagram for plant HTRK-VEN03 on storey EK1, built with BOT (building topology), FSO (flow-system topology at duct-segment level) and Brick (equipment semantics and equipment-level 'feeds' topology). Legend signatures (MOLIO C213, del 5 / Oktober 2019) are captured in the sig: vocabulary. Only items drawn on the sheet are modelled; see Notes.md for interpretation choices."@en ;
    dcterms:source "01_diagram.png - ventilation principle diagram, Anlæg HTRK-VEN03, ETAGE EK1" ,
        "02_legend.png - SIGNATURER: Signaturer iht. MOLIO C213, del 5 / Oktober 2019" ;
    dcterms:created "2026-10-08"^^xsd:date ;
    owl:imports <https://w3id.org/bot#> ,
        <https://w3id.org/fso#> ,
        <https://brickschema.org/schema/1.4/Brick> .


###############################################################################
# Legend vocabulary (sig:) - properties
###############################################################################

sig:molioCode
    a owl:AnnotationProperty ;
    rdfs:label "MOLIO code"@en ;
    rdfs:comment "Designation in the 'Molio' column of the drawing legend (Signaturer iht. MOLIO C213, del 5 / Oktober 2019)."@en ;
    rdfs:isDefinedBy <https://example.org/htrk-ven03/signatures> .

sig:bim7aaCode
    a owl:AnnotationProperty ;
    rdfs:label "BIM7AA code"@en ;
    rdfs:comment "Code in the 'BIM7AA kode' column of the drawing legend ('xx' = type number not given on the drawing)."@en ;
    rdfs:isDefinedBy <https://example.org/htrk-ven03/signatures> .

sig:legendDescription
    a owl:AnnotationProperty ;
    rdfs:label "legend description"@en ;
    rdfs:comment "Verbatim description from the 'Beskrivelse' column of the drawing legend."@en ;
    rdfs:isDefinedBy <https://example.org/htrk-ven03/signatures> .

sig:fireResistanceClass
    a owl:AnnotationProperty ;
    rdfs:label "fire resistance class"@en ;
    rdfs:comment "Fire resistance class stated in the legend for a damper signature."@en ;
    rdfs:isDefinedBy <https://example.org/htrk-ven03/signatures> .

sig:drawingLabel
    a owl:DatatypeProperty ;
    rdfs:label "drawing label"@en ;
    rdfs:comment "Text printed on the drawing next to / inside the symbol (e.g. BRS, RSP, RKS, EC, M)."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://example.org/htrk-ven03/signatures> .

sig:drawingX
    a owl:DatatypeProperty ;
    rdfs:label "drawing x"@en ;
    rdfs:comment "x pixel coordinate of the symbol centre in 01_diagram.png (7310 x 4753 px). Traceability only."@en ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://example.org/htrk-ven03/signatures> .

sig:drawingY
    a owl:DatatypeProperty ;
    rdfs:label "drawing y"@en ;
    rdfs:comment "y pixel coordinate of the symbol centre in 01_diagram.png (7310 x 4753 px). Traceability only."@en ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://example.org/htrk-ven03/signatures> .

sig:roomNumber
    a owl:DatatypeProperty ;
    rdfs:label "room number"@en ;
    rdfs:comment "Room number as printed in the room box header on the drawing."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://example.org/htrk-ven03/signatures> .

sig:continuesOnDrawing
    a owl:DatatypeProperty ;
    rdfs:label "continues on drawing"@en ;
    rdfs:comment "The duct leaves this sheet at a break symbol (~) and continues on the referenced drawing ('Se tegn.')."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://example.org/htrk-ven03/signatures> .

sig:drawingNote
    a owl:AnnotationProperty ;
    rdfs:label "drawing note"@en ;
    rdfs:comment "Observation about how the item is drawn (graphical irregularities etc.)."@en ;
    rdfs:isDefinedBy <https://example.org/htrk-ven03/signatures> .

<https://example.org/htrk-ven03/signatures>
    a owl:Ontology ;
    rdfs:label "Drawing signatures (legend) vocabulary for HTRK-VEN03"@en ;
    rdfs:comment "Minimal local vocabulary mirroring the legend signatures that occur on the drawing, aligned to FSO, Brick and BOT by rdfs:subClassOf. Replace the example.org namespace with the project namespace as needed."@en .


###############################################################################
# Legend vocabulary (sig:) - signature classes used on the drawing, aligned to FSO / Brick / BOT
###############################################################################

sig:OutdoorAirSystem
    a owl:Class ;
    rdfs:subClassOf fso:SupplySystem ,
        brick:Air_System ;
    rdfs:label "Outdoor air (intake) system"@en ,
        "Ventilation, udeluft (indtag)"@da ;
    sig:legendDescription "Ventilation, udeluft (indtag)"@da ;
    sig:molioCode "INDT" ;
    rdfs:comment "Line type: light-green solid line."@en ;
    rdfs:isDefinedBy <https://example.org/htrk-ven03/signatures> .

sig:ExhaustAirSystem
    a owl:Class ;
    rdfs:subClassOf fso:ReturnSystem ,
        brick:Air_System ;
    rdfs:label "Exhaust air (discharge) system"@en ,
        "Ventilation, afkastluft (afkast)"@da ;
    sig:legendDescription "Ventilation, afkastluft (afkast)"@da ;
    sig:molioCode "AFK" ;
    rdfs:comment "Line type: dark-green dashed line."@en ;
    rdfs:isDefinedBy <https://example.org/htrk-ven03/signatures> .

sig:SupplyAirSystem
    a owl:Class ;
    rdfs:subClassOf fso:SupplySystem ,
        brick:Air_System ;
    rdfs:label "Supply air system"@en ,
        "Ventilation, tilluft (indblæsning)"@da ;
    sig:legendDescription "Ventilation, tilluft (indblæsning)"@da ;
    sig:molioCode "VI" ;
    rdfs:comment "Line type: red solid line."@en ;
    rdfs:isDefinedBy <https://example.org/htrk-ven03/signatures> .

sig:ExtractAirSystem
    a owl:Class ;
    rdfs:subClassOf fso:ReturnSystem ,
        brick:Air_System ;
    rdfs:label "Extract air system"@en ,
        "Ventilation, fraluft (udsugning)"@da ;
    sig:legendDescription "Ventilation, fraluft (udsugning)"@da ;
    sig:molioCode "VU" ;
    rdfs:comment "Line type: blue dashed line."@en ;
    rdfs:isDefinedBy <https://example.org/htrk-ven03/signatures> .

sig:Duct
    a owl:Class ;
    rdfs:subClassOf fso:Segment ,
        bot:Element ;
    rdfs:label "Duct segment"@en ,
        "Kanal"@da ;
    rdfs:comment "One drawn ventilation line between two symbols / junctions (or between a symbol and the point where the fire-insulation marking starts or stops). The line type gives the system (INDT, AFK, VI, VU)."@en ;
    rdfs:isDefinedBy <https://example.org/htrk-ven03/signatures> .

sig:FireInsulatedDuct
    a owl:Class ;
    rdfs:subClassOf sig:Duct ;
    rdfs:label "Fire-insulated duct segment"@en ,
        "Brandisoleret kanal"@da ;
    sig:legendDescription "Brandisoleret kanal, til EIxx (EI30, EI60 eller EI120)"@da ;
    sig:molioCode "EIxx" ;
    rdfs:comment "Duct line drawn with the double dashed EIxx marking. The EI class (EI30/EI60/EI120) is not stated on the drawing."@en ;
    rdfs:isDefinedBy <https://example.org/htrk-ven03/signatures> .

sig:DuctJunction
    a owl:Class ;
    rdfs:subClassOf fso:Fitting ,
        bot:Element ;
    rdfs:label "Duct junction (branch point)"@en ,
        "Afgrening"@da ;
    rdfs:comment "Point where three drawn duct lines of the same system meet. Not a legend symbol; the fitting type (tee, branch take-off, ...) is not shown."@en ;
    rdfs:isDefinedBy <https://example.org/htrk-ven03/signatures> .

sig:SupplyAirTerminal
    a owl:Class ;
    rdfs:subClassOf fso:Terminal ,
        brick:Air_Diffuser ,
        bot:Element ;
    rdfs:label "Supply air terminal"@en ,
        "Indblæsningsarmatur"@da ;
    sig:legendDescription "Indblæsningsarmatur, type xx"@da ;
    sig:molioCode "VIxx" ;
    sig:bim7aaCode "57537xx" ;
    rdfs:comment "Symbol: bar with arrow pointing away from the duct."@en ;
    rdfs:isDefinedBy <https://example.org/htrk-ven03/signatures> .

sig:ExtractAirTerminal
    a owl:Class ;
    rdfs:subClassOf fso:Terminal ,
        brick:Terminal_Unit ,
        bot:Element ;
    rdfs:label "Extract air terminal"@en ,
        "Udsugningsarmatur"@da ;
    sig:legendDescription "Udsugningsarmatur (loftsarmatur 57537xx / loftsarmatur med synlig montage 57547xx / kontrolventil 57587xx)"@da ;
    sig:molioCode "VUxx" ;
    sig:bim7aaCode "575xxxx" ;
    rdfs:comment "Symbol: bar with arrow-head towards the bar and a wave sign. The legend uses one symbol for three sub-types; the sub-type is not distinguishable on the drawing."@en ;
    rdfs:isDefinedBy <https://example.org/htrk-ven03/signatures> .

sig:FireAndSmokeDamper_BRS
    a owl:Class ;
    rdfs:subClassOf fso:FlowController ,
        brick:Damper ,
        bot:Element ;
    rdfs:label "Fire and smoke damper (BRS)"@en ,
        "Brand- og røgspjæld"@da ;
    sig:legendDescription "Brand- og røgspjæld - Klasse EI60, type xx"@da ;
    sig:molioCode "BRSxx" ;
    sig:bim7aaCode "57337xx" ;
    sig:fireResistanceClass "EI60" ;
    rdfs:comment "Motorised (M) fire and smoke damper, class EI60 per legend."@en ;
    rdfs:isDefinedBy <https://example.org/htrk-ven03/signatures> .

sig:SmokeDamper_RSP
    a owl:Class ;
    rdfs:subClassOf fso:FlowController ,
        brick:Damper ,
        bot:Element ;
    rdfs:label "Smoke damper (RSP)"@en ,
        "Røgspjæld"@da ;
    sig:legendDescription "Røgspjæld - Klasse E30, type xx"@da ;
    sig:molioCode "RSPxx" ;
    sig:bim7aaCode "57337xx" ;
    sig:fireResistanceClass "E30" ;
    rdfs:comment "Motorised (M) smoke damper, class E30 per legend."@en ;
    rdfs:isDefinedBy <https://example.org/htrk-ven03/signatures> .

sig:SmokeControlDamper_RKS
    a owl:Class ;
    rdfs:subClassOf fso:FlowController ,
        brick:Damper ,
        bot:Element ;
    rdfs:label "Smoke control damper (RKS)"@en ,
        "Røgkontrolspjæld"@da ;
    sig:legendDescription "Røgkontrolspjæld, type xx"@da ;
    sig:molioCode "RKSxx" ;
    sig:bim7aaCode "57357xx" ;
    rdfs:comment "Motorised (M) smoke control damper. No fire resistance class is stated in the legend."@en ;
    rdfs:isDefinedBy <https://example.org/htrk-ven03/signatures> .

sig:VAVDamper
    a owl:Class ;
    rdfs:subClassOf fso:FlowController ,
        brick:Variable_Air_Volume_Box ,
        bot:Element ;
    rdfs:label "VAV damper with measuring cross"@en ,
        "VAV-spjæld med målekors"@da ;
    sig:legendDescription "VAV-spjæld, med målekors, type xx"@da ;
    sig:molioCode "VVxx" ;
    sig:bim7aaCode "57377xx" ;
    rdfs:comment "Motorised (M) variable-air-volume damper with flow measuring cross."@en ;
    rdfs:isDefinedBy <https://example.org/htrk-ven03/signatures> .

sig:Volustat
    a owl:Class ;
    rdfs:subClassOf fso:FlowController ,
        brick:Damper ,
        bot:Element ;
    rdfs:label "Volustat"@en ,
        "Volustat"@da ;
    sig:legendDescription "Volustat, type xx"@da ;
    sig:molioCode "VSxx" ;
    sig:bim7aaCode "57377xx" ;
    rdfs:comment "Drawn without actuator. The legend gives no further description than 'Volustat'."@en ;
    rdfs:isDefinedBy <https://example.org/htrk-ven03/signatures> .

sig:Fan
    a owl:Class ;
    rdfs:subClassOf fso:FlowMovingDevice ,
        brick:Fan ,
        bot:Element ;
    rdfs:label "Fan"@en ,
        "Ventilator"@da ;
    sig:legendDescription "Ventilatorer: Ventilator, type xx (57417xx) / Axialventilator, type xx (57427xx)"@da ;
    sig:bim7aaCode "57417xx / 57427xx" ;
    rdfs:comment "The legend uses one symbol for 'Ventilator' and 'Axialventilator'; the fan type is not distinguishable."@en ;
    rdfs:isDefinedBy <https://example.org/htrk-ven03/signatures> .

sig:ECMotor
    a owl:Class ;
    rdfs:subClassOf fso:EnergyConversionDevice ,
        brick:Motor ,
        brick:HVAC_Equipment ,
        bot:Element ;
    rdfs:label "EC motor"@en ,
        "EC-motor"@da ;
    sig:legendDescription "EC-motor"@da ;
    rdfs:comment "Drawn as the boxed text 'EC' next to a fan symbol."@en ;
    rdfs:isDefinedBy <https://example.org/htrk-ven03/signatures> .

sig:DamperMotor
    a owl:Class ;
    rdfs:subClassOf fso:EnergyConversionDevice ,
        brick:Motor ,
        brick:HVAC_Equipment ,
        bot:Element ;
    rdfs:label "Damper motor (M)"@en ,
        "Spjældmotor (M)"@da ;
    sig:legendDescription "Motor (M) of a motorised damper signature (BRSxx, RSPxx, RKSxx, VVxx)"@da ;
    rdfs:comment "The circled 'M' drawn on motorised damper symbols."@en ;
    rdfs:isDefinedBy <https://example.org/htrk-ven03/signatures> .

sig:AirFilter
    a owl:Class ;
    rdfs:subClassOf fso:TreatmentDevice ,
        brick:Filter ,
        bot:Element ;
    rdfs:label "Air filter"@en ,
        "Luftfilter"@da ;
    sig:legendDescription "Luftfilter, type xx"@da ;
    sig:bim7aaCode "57387xx" ;
    rdfs:isDefinedBy <https://example.org/htrk-ven03/signatures> .

sig:Silencer
    a owl:Class ;
    rdfs:subClassOf fso:TreatmentDevice ,
        brick:HVAC_Equipment ,
        bot:Element ;
    rdfs:label "Silencer (sound attenuator)"@en ,
        "Lyddæmper"@da ;
    sig:legendDescription "Lyddæmper, type xx"@da ;
    sig:molioCode "LYDxx" ;
    sig:bim7aaCode "57317xx" ;
    rdfs:comment "Brick 1.4 has no silencer class, hence the generic brick:HVAC_Equipment."@en ;
    rdfs:isDefinedBy <https://example.org/htrk-ven03/signatures> .

sig:HeatingCoil
    a owl:Class ;
    rdfs:subClassOf fso:EnergyConversionDevice ,
        brick:Heating_Coil ,
        bot:Element ;
    rdfs:label "Heating coil"@en ,
        "Varmeflade"@da ;
    sig:legendDescription "Varmeflade, type xx"@da ;
    sig:molioCode "VFLxx" ;
    sig:bim7aaCode "57227xx" ;
    rdfs:comment "Heating medium not shown on the drawing."@en ;
    rdfs:isDefinedBy <https://example.org/htrk-ven03/signatures> .

sig:RotaryHeatExchanger
    a owl:Class ;
    rdfs:subClassOf fso:EnergyConversionDevice ,
        brick:Heat_Wheel ,
        bot:Element ;
    rdfs:label "Rotary heat exchanger"@en ,
        "Rotorveksler"@da ;
    sig:legendDescription "Rotorveksler, type xx"@da ;
    sig:bim7aaCode "57267xx" ;
    rdfs:isDefinedBy <https://example.org/htrk-ven03/signatures> .


###############################################################################
# Building topology (BOT) - building, storey, zone and spaces (+ Brick location classes)
###############################################################################

# Not named on the drawing: implicit container of storey EK1 (see Notes.md).
inst:Building
    a bot:Building ,
        brick:Building ;
    rdfs:label "Building (not named on the drawing)"@en ;
    bot:hasStorey inst:Storey_EK1 ;
    brick:hasPart inst:Storey_EK1 .

inst:Storey_EK1
    a bot:Storey ,
        brick:Floor ;
    rdfs:label "ETAGE EK1"@da ;
    bot:hasSpace inst:Space_TEKNIKRUM ,
        inst:Space_RK1-03 ,
        inst:Space_RK1-05 ,
        inst:Space_RK1-14 ,
        inst:Space_RK1-04 ,
        inst:Space_RK1-15 ,
        inst:Space_RK1-54 ,
        inst:Space_RK1-59 ,
        inst:Space_RL2-01 ,
        inst:Space_RK1-09 ,
        inst:Space_RK1-52 ,
        inst:Space_RK1-53 ;
    bot:containsZone inst:Zone_RK1-52_RK1-53 ;
    brick:hasPart inst:Space_TEKNIKRUM ,
        inst:Space_RK1-03 ,
        inst:Space_RK1-05 ,
        inst:Space_RK1-14 ,
        inst:Space_RK1-04 ,
        inst:Space_RK1-15 ,
        inst:Space_RK1-54 ,
        inst:Space_RK1-59 ,
        inst:Space_RL2-01 ,
        inst:Space_RK1-09 ,
        inst:Space_RK1-52 ,
        inst:Space_RK1-53 ,
        inst:Zone_RK1-52_RK1-53 ;
    bot:containsElement inst:Junction_VI_01 ,
        inst:Junction_VI_02 ,
        inst:Junction_VU_01 ,
        inst:Junction_VU_02 ,
        inst:Duct_VI_02 ,
        inst:Duct_VI_03 ,
        inst:Duct_VI_04 ,
        inst:Duct_VI_05 ,
        inst:Duct_VI_06 ,
        inst:Duct_VU_01 ,
        inst:Duct_VU_03 ,
        inst:Duct_VU_04 ,
        inst:Duct_VU_05 ,
        inst:Duct_VU_41 .

inst:Space_TEKNIKRUM
    a bot:Space ,
        brick:Mechanical_Room ;
    rdfs:label "TEKNIKRUM"@da ;
    bot:containsElement inst:AHU_HTRK-VEN03 ,
        inst:AHU_HTRK-VEN03_ExhaustFan ,
        inst:AHU_HTRK-VEN03_IntakeFilter ,
        inst:AHU_HTRK-VEN03_Rotor ,
        inst:AHU_HTRK-VEN03_ExtractFilter ,
        inst:AHU_HTRK-VEN03_SupplyFan ,
        inst:AHU_HTRK-VEN03_HeatingCoil ,
        inst:AHU_HTRK-VEN03_ExhaustFan_ECMotor ,
        inst:AHU_HTRK-VEN03_SupplyFan_ECMotor ,
        inst:RSP_AFK_TEKNIKRUM ,
        inst:RSP_AFK_TEKNIKRUM_Motor ,
        inst:RSP_INDT_TEKNIKRUM ,
        inst:RSP_INDT_TEKNIKRUM_Motor ,
        inst:LYD_VU_TEKNIKRUM ,
        inst:LYD_VI_TEKNIKRUM ,
        inst:Duct_INDT_01 ,
        inst:Duct_INDT_02 ,
        inst:Duct_AFK_01 ,
        inst:Duct_AFK_02 ,
        inst:Duct_VI_01 ,
        inst:Duct_VU_02 ;
    bot:intersectingElement inst:Duct_VI_02 ,
        inst:Duct_VU_01 .

inst:Space_RK1-03
    a bot:Space ,
        brick:Room ;
    rdfs:label "Køl og varmerum - RK1.03"@da ;
    sig:roomNumber "RK1.03" ;
    bot:containsElement inst:BRS_VU_RK1-03 ,
        inst:BRS_VU_RK1-03_Motor ,
        inst:BRS_VI_RK1-03 ,
        inst:BRS_VI_RK1-03_Motor ,
        inst:VS_VU_RK1-03 ,
        inst:VS_VI_RK1-03 ,
        inst:LYD_VU_RK1-03 ,
        inst:LYD_VI_RK1-03 ,
        inst:ATD_VI_RK1-03 ,
        inst:ATD_VU_RK1-03 ,
        inst:Junction_VI_03 ,
        inst:Junction_VU_03 ,
        inst:Duct_VI_07 ,
        inst:Duct_VI_08 ,
        inst:Duct_VI_09 ,
        inst:Duct_VI_10 ,
        inst:Duct_VI_11 ,
        inst:Duct_VU_19 ,
        inst:Duct_VU_20 ,
        inst:Duct_VU_21 ,
        inst:Duct_VU_22 ,
        inst:Duct_VU_23 ;
    bot:intersectingElement inst:Duct_VI_04 ,
        inst:Duct_VU_04 ;
    fso:returnsFluidTo inst:ATD_VU_RK1-03 .

inst:Space_RK1-05
    a bot:Space ,
        brick:Storage_Room ;
    rdfs:label "Arkiv - RK1.05"@da ;
    sig:roomNumber "RK1.05" ;
    bot:containsElement inst:BRS_VU_RK1-05 ,
        inst:BRS_VU_RK1-05_Motor ,
        inst:BRS_VI_RK1-05 ,
        inst:BRS_VI_RK1-05_Motor ,
        inst:ATD_VI_RK1-05 ,
        inst:ATD_VU_RK1-05 ,
        inst:Junction_VI_04 ,
        inst:Junction_VI_05 ,
        inst:Junction_VU_04 ,
        inst:Junction_VU_05 ,
        inst:Duct_VI_12 ,
        inst:Duct_VI_13 ,
        inst:Duct_VI_14 ,
        inst:Duct_VI_17 ,
        inst:Duct_VU_13 ,
        inst:Duct_VU_16 ,
        inst:Duct_VU_17 ,
        inst:Duct_VU_18 ;
    bot:intersectingElement inst:Duct_VI_15 ,
        inst:Duct_VU_15 ;
    fso:returnsFluidTo inst:ATD_VU_RK1-05 .

inst:Space_RK1-14
    a bot:Space ,
        brick:Server_Room ;
    rdfs:label "Serverrum - RK1.14"@da ;
    sig:roomNumber "RK1.14" ;
    bot:containsElement inst:BRS_VI_RK1-14 ,
        inst:BRS_VI_RK1-14_Motor ,
        inst:BRS_VU_RK1-14 ,
        inst:BRS_VU_RK1-14_Motor ,
        inst:ATD_VI_RK1-14 ,
        inst:ATD_VU_RK1-14 ,
        inst:Junction_VI_06 ,
        inst:Junction_VU_06 ,
        inst:Duct_VI_18 ,
        inst:Duct_VI_19 ,
        inst:Duct_VI_20 ,
        inst:Duct_VI_21 ,
        inst:Duct_VU_09 ,
        inst:Duct_VU_10 ,
        inst:Duct_VU_11 ,
        inst:Duct_VU_12 ;
    fso:returnsFluidTo inst:ATD_VU_RK1-14 .

inst:Space_RK1-04
    a bot:Space ,
        brick:Janitor_Room ;
    rdfs:label "Rengøringscentral - RK1.04"@da ;
    sig:roomNumber "RK1.04" ;
    bot:containsElement inst:BRS_VU_RK1-04 ,
        inst:BRS_VU_RK1-04_Motor ,
        inst:BRS_VI_RK1-04 ,
        inst:BRS_VI_RK1-04_Motor ,
        inst:VAV_VU_RK1-04 ,
        inst:VAV_VU_RK1-04_Motor ,
